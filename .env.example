# Copy this file to `.env` and fill in your own key, or set the variable in
# your shell. The web Models page is an alternative: it writes keys to
# `$DSH_HOME/.credentials.yaml` (default `~/.dsh/.credentials.yaml`).

DEEPSEEK_API_KEY=

# Optional. Defaults to https://api.deepseek.com
# DEEPSEEK_BASE_URL=
